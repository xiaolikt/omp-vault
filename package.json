{
	"name": "@xiaolikt/ai-vault",
	"version": "0.11.0",
	"description": "One machine-wide encrypted secret store for AI coding agents: the ai-vault Rust CLI (npm-installable, Linux/macOS/Windows) plus the pi-ai-vault extension for pi and omp.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xiaolikt/ai-vault.git"
	},
	"author": "xiaolikt",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"ai-vault",
		"vault",
		"secrets",
		"password-store",
		"cli",
		"rust",
		"omp-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"security",
		"omp"
	],
	"bin": {
		"ai-vault": "./bin/ai-vault.cjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"optionalDependencies": {
		"@xiaolikt/ai-vault-linux-x64": "0.11.0",
		"@xiaolikt/ai-vault-linux-arm64": "0.11.0",
		"@xiaolikt/ai-vault-win32-x64": "0.11.0"
	},
	"files": [
		"bin",
		"crates",
		"packages",
		"Cargo.toml",
		"Cargo.lock",
		"install.sh",
		"test",
		"tests",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build:cli": "cargo build --release",
		"stage:npm": "bash scripts/stage-npm.sh",
		"pretest": "cargo build --release",
		"test": "node --import tsx --test tests/*.test.mjs",
		"test:cli": "bash test/cli.sh",
		"test:npm": "bash test/npm.sh",
		"test:cargo": "cargo test",
		"test:smoke": "bash test/smoke.sh",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@types/node": "^24.0.0",
		"tsx": "^4.23.15",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	},
	"pi": {
		"extensions": [
			"./packages/pi-ai-vault/src/index.ts"
		]
	}
}
