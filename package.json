{
	"name": "ai-vault",
	"version": "0.4.0",
	"description": "One machine-wide encrypted secret store for AI coding agents: a Rust CLI (ai-vault) that owns the store, plus a thin pi/omp extension that calls it.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xiaolikt/ai-vault.git"
	},
	"author": "xiaolikt",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"ai-vault",
		"omp-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"vault",
		"secrets",
		"security",
		"rust",
		"omp"
	],
	"files": [
		"src",
		"crates",
		"Cargo.toml",
		"install.sh",
		"test",
		"tests",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build:cli": "cargo build --release",
		"pretest": "cargo build --release",
		"test": "node --import tsx --test tests/*.test.mjs",
		"test:cli": "bash test/cli.sh",
		"test:cargo": "cargo test",
		"test:smoke": "bash test/smoke.sh",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@types/node": "^24.0.0",
		"tsx": "^4.23.15",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
