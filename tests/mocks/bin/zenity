#!/bin/bash
# Mock zenity for the omp-vault tests. Every call is one line in
# $OMP_VAULT_MOCK/zenity.log (newlines inside an argument show as ⏎).
#   --password   a master-password dialog (its title says 主密码) answers with
#                the first line of $OMP_VAULT_MOCK/passwords, or "testmaster"
#                when that file is missing or empty; any other password dialog
#                answers with the first line of $OMP_VAULT_MOCK/entry-passwords
#   --entry      first line of $OMP_VAULT_MOCK/entries; empty when the file is gone
#   --question   allow, unless $OMP_VAULT_MOCK/deny exists (then exit 1)
DIR="${OMP_VAULT_MOCK:-/tmp/omp-vault-mock}"
mkdir -p "$DIR"
printf '%s\n' "${*//$'\n'/⏎}" >> "$DIR/zenity.log"
take_first() {
	local first rest
	first="$(head -n 1 "$1" 2>/dev/null)"
	rest="$(tail -n +2 "$1" 2>/dev/null)"
	# An exhausted queue is removed, not left as an empty line: the next dialog
	# then falls back to its default instead of reading an empty answer.
	if [[ -n "$rest" ]]; then printf '%s\n' "$rest" > "$1"; else rm -f "$1"; fi
	printf '%s\n' "$first"
}
for arg in "$@"; do
	case "$arg" in
		--password)
			kind="entry"
			for a in "$@"; do [[ "$a" == --title=*主密码* ]] && kind="master"; done
			if [[ "$kind" == "master" ]]; then
				if [[ -s "$DIR/passwords" ]]; then take_first "$DIR/passwords"; else echo "testmaster"; fi
			elif [[ -f "$DIR/entry-passwords" ]]; then
				take_first "$DIR/entry-passwords"
			else
				echo ""
			fi
			exit 0 ;;
		--entry)
			if [[ -f "$DIR/entries" ]]; then take_first "$DIR/entries"; else echo ""; fi
			exit 0 ;;
		--question)
			[[ -f "$DIR/deny" ]] && exit 1
			exit 0 ;;
	esac
done
exit 0
